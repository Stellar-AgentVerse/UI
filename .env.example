# URL where the NestJS backend is running.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Soroban RPC used to submit the purchase transaction and poll for its ledger
# result. Defaults to the Testnet node when unset.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Where a buyer is sent to reconcile a purchase. Must be an https URL; if it is
# unset or malformed the UI falls back to this repository's issue tracker rather
# than rendering a placeholder address.
# NEXT_PUBLIC_SUPPORT_URL=

# Explorer origin used for transaction receipts. Defaults to stellar.expert.
# NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert
